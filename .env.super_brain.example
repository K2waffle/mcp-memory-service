# Super-Brain — environment variables template
#
# Copy to `.env.super_brain` (gitignored) and fill in real values.
# For Railway deploy: paste the non-secret defaults below into Railway's
# Variables UI, then add the Cloudflare credentials as Railway Secrets.

# -----------------------------------------------------------------------------
# Core enablement
# -----------------------------------------------------------------------------
MCP_SUPER_BRAIN_ENABLED=true
MCP_HTTP_ENABLED=true
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=${PORT:-8000}

# -----------------------------------------------------------------------------
# Storage backend — use 'cloudflare' for cloud-only, 'hybrid' for local+cloud.
# For Railway production: 'cloudflare' (no disk dependency on Railway).
# For self-hosted + CF mirror: 'hybrid' with MCP_HYBRID_SYNC_OWNER=http.
# -----------------------------------------------------------------------------
MCP_MEMORY_STORAGE_BACKEND=cloudflare

# Cloudflare (required for cloudflare/hybrid backends)
CLOUDFLARE_API_TOKEN=          # create a scoped token; see handoff.md
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_VECTORIZE_INDEX=mcp-memory-index
# R2 bucket for object_artifacts binary storage. Name must match the
# bucket created in handoff.md Step 1.4 (default: super-brain-artifacts).
CLOUDFLARE_R2_BUCKET=super-brain-artifacts

# -----------------------------------------------------------------------------
# OAuth 2.1 Dynamic Client Registration (RFC 7591) — upstream ships this
# -----------------------------------------------------------------------------
MCP_OAUTH_STORAGE_BACKEND=sqlite
MCP_OAUTH_SQLITE_PATH=/app/sqlite_db/oauth.db
# Issuer URL — MUST match the Railway domain generated in handoff.md Step 2.
# DCR tokens fail verification if this value differs from the host the
# client reaches. Update this after Step 2 and redeploy.
MCP_OAUTH_ISSUER=https://<your-railway-domain>.up.railway.app

# -----------------------------------------------------------------------------
# API key gate (front-of-house auth for MCP tools; OAuth is separate)
# -----------------------------------------------------------------------------
MCP_API_KEY=                   # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"

# -----------------------------------------------------------------------------
# Super-brain markdown mirror — where artifacts land as .md files
# Default: repo-root/artifacts. In Docker the repo root maps to /app, so we
# point this at a persistent volume if the git-track workflow runs externally.
# -----------------------------------------------------------------------------
MCP_SUPER_BRAIN_ARTIFACT_ROOT=/app/artifacts

# -----------------------------------------------------------------------------
# Quality system (upstream multi-tier scoring) — optional extras
# -----------------------------------------------------------------------------
MCP_QUALITY_SYSTEM_ENABLED=true
# MCP_QUALITY_GROQ_KEY=         # optional fallback scorer
# MCP_QUALITY_GEMINI_KEY=       # optional high-accuracy scorer

# -----------------------------------------------------------------------------
# Consolidation — dream-inspired memory maintenance (upstream v8.23.0+)
# -----------------------------------------------------------------------------
MCP_CONSOLIDATION_ENABLED=true

# -----------------------------------------------------------------------------
# SQLite pragmas — ONLY if using hybrid/sqlite_vec backends
# WAL mode required for concurrent HTTP + MCP access
# -----------------------------------------------------------------------------
MCP_MEMORY_SQLITE_PRAGMAS=journal_mode=WAL,busy_timeout=15000,cache_size=20000

# -----------------------------------------------------------------------------
# Payments (super-brain extension) — Stripe credentials.
# Fill in after creating the Stripe account + webhook per handoff.md Step 4.
# STRIPE_SECRET_KEY is the var name checked by payments/stripe_client.py.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PCI_SCOPE=saq_a         # SAQ-A if all payments via Stripe Checkout

# -----------------------------------------------------------------------------
# Notion sync (super-brain extension) — mirrors decisions / procedures /
# opportunities into three Notion databases for human browsing.
# Setup: notion_sync/README.md (one-time: create integration + 3 DBs).
# These vars are only needed wherever you RUN notion_sync/sync.py — local
# machine, GitHub Action, or a Railway cron service. The main Railway
# server does not need them.
# -----------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_DB_DECISIONS=
NOTION_DB_PROCEDURES=
NOTION_DB_OPPORTUNITIES=
# NOTION_SYNC_DRY_RUN=1          # optional: log-only, don't write

# -----------------------------------------------------------------------------
# Windows-specific: extend init timeout if cold start is slow
# (Not needed on Railway Linux containers)
# -----------------------------------------------------------------------------
# MCP_INIT_TIMEOUT=120

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
